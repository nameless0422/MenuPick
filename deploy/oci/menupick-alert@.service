[Unit]
Description=MenuPick 실패 알림 (%i)
# 이 유닛에는 OnFailure를 두지 않는다. 알림이 실패했다고 다시 알림을 띄우면
# 웹훅이 죽어 있는 동안 유닛 두 개가 서로를 부르며 journal만 채운다.
# 알림 전송 실패는 `systemctl --failed`와 journal에 남는다.

[Service]
Type=oneshot

# root로 돈다. 두 가지가 필요하다:
#   1) /etc/menupick/alert.env (0600 root) — 웹훅 URL은 그 자체로 자격증명이라
#      opc가 읽을 수 있게 두지 않는다.
#   2) 실패한 유닛의 journal 꼬리.
# 스크립트는 URL을 출력하지 않는다(scripts/notify-failure.sh 참고).
ExecStart=/usr/local/bin/menupick-alert %i

StandardOutput=journal
StandardError=journal
