<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 메시지의 줄바꿈·제어 문자를 이스케이프한다 (로그 위조, CWE-117).
  근거와 배경은 CrlfSafeMessageConverter의 주석과 docs/DecisionLog.md D-078.

  이 파일이 하는 일은 **%m 하나를 갈아 끼우는 것뿐**이다. 나머지는 전부 Spring Boot의 기본
  구성을 그대로 가져다 쓴다 — 콘솔 패턴을 여기 복사해 두면 Boot가 패턴을 바꿀 때 조용히
  어긋나고, application.yml의 logging.pattern.level(traceId·userId)도 여기서 다시 맞춰야 한다.
  포함(include)으로 두면 logging.level.*, logging.pattern.level 같은 설정이 지금까지와 똑같이 듣는다.

  base.xml을 쓰지 않는 이유: 그 파일은 FILE 어펜더를 함께 걸어 임시 디렉터리에 spring.log를
  만든다. 이 서비스는 콘솔로만 내보내고(컨테이너 로그 → journald) 파일은 쓰지 않는다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      %m, %msg, %message는 같은 변환기의 세 이름이다. 셋 다 덮는다 — 하나만 덮으면 누군가
      패턴을 %msg로 바꾸는 순간 보호가 사라진다. 같은 이름으로 등록한 규칙이 logback 기본을
      덮어쓰는지는 LogForgingTest가 이 프로젝트의 logback 버전에서 확인한다.
    -->
    <conversionRule conversionWord="m"
                    class="com.nameless0422.MenuPick.common.logging.CrlfSafeMessageConverter"/>
    <conversionRule conversionWord="msg"
                    class="com.nameless0422.MenuPick.common.logging.CrlfSafeMessageConverter"/>
    <conversionRule conversionWord="message"
                    class="com.nameless0422.MenuPick.common.logging.CrlfSafeMessageConverter"/>

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
