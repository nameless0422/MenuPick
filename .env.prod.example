# docker-compose.prod.yml용 환경변수 템플릿.
# 실제 값을 채운 뒤 .env.prod로 저장한다 (Git에 커밋 금지 — .gitignore 처리 필요).

MYSQL_ROOT_PASSWORD=
DB_USERNAME=menupick
DB_PASSWORD=

# Redis requirepass. 컨테이너 네트워크 밖으로 포트를 열지 않더라도 반드시 설정한다
# (Refresh Token 저장소이므로 무인증 Redis = 세션 전체 노출).
# 미설정 시 docker compose가 기동을 거부한다. openssl rand -base64 24 등으로 생성.
REDIS_PASSWORD=

# openssl rand -base64 32 등으로 생성한 256bit 이상 랜덤 문자열
JWT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_REST_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# 지도 API 게이트웨이 도메인 — 비워 두면 compose의 기본값(구 도메인)을 쓴다.
# 운영 로그에 '네이버 Geocode API 응답 오류: status=401'(또는 404)이 보이면 도메인 이전이
# 일어난 것이므로 아래 두 줄을 채우고 재기동한다 (#76).
#   NAVER_MAPS_GEOCODE_URL=https://maps.apigw.ntruss.com/map-geocode/v2/geocode
#   NAVER_MAPS_REVERSE_GEOCODE_URL=https://maps.apigw.ntruss.com/map-reversegeocode/v2/gc

# 프론트엔드가 실제로 서비스되는 오리진 (예: https://menupick.example.com). 쉼표로 복수 지정 가능
FRONTEND_ORIGIN=

# 자체(이메일+비밀번호) 계정의 메일 인증·비밀번호 재설정 발송용 SMTP.
# 미설정 시 앱이 기동에 실패한다 — 조용히 떠서 가입자가 인증 메일을 못 받는 것보다 낫다는 판단.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신자 주소. SMTP 제공자가 인증(SPF/DKIM)한 도메인이어야 스팸함으로 가지 않는다.
MAIL_FROM=
# 메일에 넣을 링크의 프론트엔드 주소 (예: https://menupick.example.com).
# FRONTEND_ORIGIN과 달리 반드시 단일 오리진이어야 한다 — 링크는 하나만 만들 수 있다.
# 요청 Host 헤더로 유추하지 않는 이유: 위조하면 인증 링크를 공격자 도메인으로 돌릴 수 있다.
MAIL_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 레이트 리밋 / 프록시 토폴로지
# ─────────────────────────────────────────────────────────────
# 클라이언트 IP를 X-Forwarded-For의 "오른쪽에서 N번째"로 판정한다.
# 이 값은 앱 앞에 실제로 놓인 프록시 수와 정확히 같아야 한다.
#   1 = compose의 web(nginx)만 앞에 있는 기본 구성
#   2 = 그 앞에 TLS 종단 프록시가 한 겹 더 있는 구성
# 실제보다 작게 잡으면 오른쪽 N번째가 클라이언트가 아니라 프록시 IP가 되어
# 전 사용자가 버킷 하나를 공유하고, 인증 경로가 분당 10회에서 429로 막힌다.
# 크게 잡으면 클라이언트가 보낸 위조 XFF 값을 신뢰하게 되어 한도를 우회당한다.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────
# 배포 이미지
# ─────────────────────────────────────────────────────────────
# CI가 GHCR에 올린 이미지 태그. 커밋 SHA를 쓰면 롤백은 이 값 한 줄 교체로 끝난다.
# latest는 "지금 main"이라 롤백 지점이 남지 않으니 운영에서는 SHA 사용을 권한다.
APP_VERSION=latest

# ─────────────────────────────────────────────────────────────
# 프론트엔드 빌드 인자
# ─────────────────────────────────────────────────────────────
# VITE_API_BASE_URL은 compose가 빈 문자열로 고정한다 — nginx가 같은 오리진에서
# /api를 프록시하므로 상대경로가 정답이다. 아래는 브라우저에 노출되어도 되는 값만 있다
# (client_secret은 서버 전용이라 여기 없다).
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=https://example.com/oauth/kakao/callback
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://example.com/oauth/google/callback

# 카카오맵 JS SDK 키. 위 KAKAO_REST_API_KEY와는 **다른 값**이다 — 카카오 콘솔의
# "앱 키 > JavaScript 키"를 넣는다. REST 키를 여기 넣으면 그 값이 번들에 공개되어
# 누구나 우리 장소 검색 할당량을 소진시킬 수 있다.
# JS 키는 공개가 전제인 키라 노출 자체가 문제되지 않고, 콘솔의
# "플랫폼 > Web > 사이트 도메인"에 배포 주소를 등록해 두는 것이 보호 수단이다.
# 비워 두면 지도만 안 뜨고 앱은 그대로 동작한다.
VITE_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────────
# 메모리 한도 (인스턴스 사양에 맞춰 조정)
# ─────────────────────────────────────────────────────────────
# 기본값은 넉넉한 인스턴스(RAM 4GB+) 기준이다. 합계가 물리 RAM을 넘으면
# 스와핑으로 사실상 멈추므로, 작은 인스턴스에서는 반드시 줄여야 한다.
#   RAM 1GB 예시:  MYSQL=384m  REDIS=64m  APP=384m  WEB=32m
MYSQL_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m
APP_MEM_LIMIT=1536m
WEB_MEM_LIMIT=64m
